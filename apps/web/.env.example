NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
# Lectura de Neon en el build (rama dev en local y en previews).
DATABASE_URL=postgresql://...
# Clave de prueba de Turnstile (siempre valida). En producción: la del widget real.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Contenedor de Google Tag Manager (vacío = sin GTM).
NEXT_PUBLIC_GTM_ID=
# Base pública de las imágenes en R2.
NEXT_PUBLIC_IMG_URL=http://localhost:8787/img
