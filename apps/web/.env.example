NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
# Lectura de Neon en el build (rama dev en local y en previews).
DATABASE_URL=postgresql://...
# Clave de prueba de Turnstile (siempre valida). En producción: la del widget real.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Contenedor de Google Tag Manager (vacío = sin GTM).
NEXT_PUBLIC_GTM_ID=
# Etiqueta de Google Ads (gtag.js). Vacío = AW-18521160532; el valor del panel tiene prioridad.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Base pública de las imágenes en R2.
NEXT_PUBLIC_IMG_URL=http://localhost:8787/img
# Producción: https://electricidadcarlospaz.proyectoswebsite.com/img

# GA4 (G-XXXXXXXXXX). Si GA4 ya está configurado dentro de GTM, dejar vacío para no duplicar.
NEXT_PUBLIC_GA4_ID=
# Conversiones de Google Ads (send_to: AW-XXXXXXXXX/etiqueta), una por acción.
# WhatsApp y formulario usan la conversión actual hasta que se carguen. Llamada vacía = no se envía.
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO_WHATSAPP=
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO_LLAMADA=
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO_FORMULARIO=
# Perfil de Empresa de Google. Vacíos = no se muestran el botón de reseña ni sameAs.
NEXT_PUBLIC_GBP_URL=
NEXT_PUBLIC_GBP_REVIEW_URL=
