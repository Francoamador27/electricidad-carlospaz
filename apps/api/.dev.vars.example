DATABASE_URL=postgresql://...  # rama dev de Neon
# Clave de prueba de Turnstile que siempre valida.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Solo en local: el panel funciona sin Cloudflare Access. NUNCA en producción.
ADMIN_SIN_AUTH=1
# Local: el sitio corre en otro puerto.
ALLOWED_ORIGINS=http://localhost:3000
AVISO_DESTINO=tu@email.com
# Vercel Blob (fotos del panel): Storage → Blob → tu store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# private (por defecto) o public, según cómo se creó el store.
BLOB_ACCESS=private
